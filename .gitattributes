# Normalize text files across Windows and other platforms.
* text=auto eol=lf

# Windows solution files are traditionally CRLF.
*.sln text eol=crlf

# Windows scripts.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Source and project files.
*.cs text eol=lf
*.xaml text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.slnx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.editorconfig text eol=lf
*.gitignore text eol=lf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
*.7z binary
*.nupkg binary
*.snk binary

# Generated files that should remain generated.
*.min.js linguist-generated=true
*.min.css linguist-generated=true
