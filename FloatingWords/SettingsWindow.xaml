<Window x:Class="FloatingWords.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FloatingWords.Design"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:SettingsWindowDesignData, IsDesignTimeCreatable=True}"
        Title="设置 · 词浮"
        Width="900"
        Height="656"
        MinWidth="800"
        MinHeight="580"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Foreground="#E9EFFB"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <SolidColorBrush x:Key="CardBrush" Color="#12FFFFFF" />
        <SolidColorBrush x:Key="LineBrush" Color="#1FFFFFFF" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9AA9C2" />
        <SolidColorBrush x:Key="AccentBrush" Color="#75D6AE" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AEB8CC" />
        <SolidColorBrush x:Key="HoverWashBrush" Color="#14FFFFFF" />

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="28"
                          ShadowDepth="7"
                          Direction="270"
                          Opacity="0.42"
                          Color="#000000" />

        <Style x:Key="HeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="23" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F5F8FF" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F0F3FA" />
        </Style>

        <Style x:Key="MutedTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,13" />
        </Style>

        <Style x:Key="SettingsButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                CornerRadius="7"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background"
                                        Value="{StaticResource HoverWashBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsButtonStyle}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFD8DE" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F4FFF9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface"
                                CornerRadius="9"
                                BorderThickness="1"
                                BorderBrush="#5575D6AE"
                                Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3875D6AE" Offset="0" />
                                    <GradientStop Color="#2E79AEF2" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#A075D6AE" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsButtonStyle}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="9,0" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="SettingsTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#F5F8FF" />
            <Setter Property="CaretBrush" Value="#F5F8FF" />
            <Setter Property="SelectionBrush" Value="#6075D6AE" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Surface"
                                CornerRadius="8"
                                Background="#1FFFFFFF"
                                BorderBrush="#2EFFFFFF"
                                BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#2BFFFFFF" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#8C75D6AE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#F5F8FF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Surface"
                                                CornerRadius="8"
                                                Background="#1FFFFFFF"
                                                BorderBrush="#2EFFFFFF"
                                                BorderThickness="1" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Surface" Property="BorderBrush" Value="#8C75D6AE" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="8,0,22,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center" />

                            <TextBox x:Name="PART_EditableTextBox"
                                     Margin="8,0,22,0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="{TemplateBinding FontSize}"
                                     Foreground="{TemplateBinding Foreground}"
                                     CaretBrush="#F5F8FF"
                                     SelectionBrush="#6075D6AE"
                                     VerticalAlignment="Center"
                                     Visibility="Hidden"
                                     IsReadOnly="{TemplateBinding IsReadOnly}" />

                            <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                  Fill="#9AA9C2"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,10,0"
                                  IsHitTestVisible="False" />

                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border CornerRadius="8"
                                        Margin="0,4,0,0"
                                        Padding="4"
                                        Background="#1B2231"
                                        BorderBrush="#2EFFFFFF"
                                        BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ContentSite" Property="Visibility" Value="Hidden" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Padding" Value="8,5" />
                        <Setter Property="Foreground" Value="#F0F3FA" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemSurface"
                                            CornerRadius="6"
                                            Background="Transparent"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemSurface" Property="Background" Value="#2A75D6AE" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemSurface" Property="Background" Value="#3375D6AE" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DCE4F2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box"
                                    Width="14"
                                    Height="14"
                                    CornerRadius="4"
                                    Background="#1FFFFFFF"
                                    BorderBrush="#4DFFFFFF"
                                    BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Check"
                                      Data="M 2,6 L 5,9 L 10,3"
                                      Stroke="#0E1A16"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#75D6AE" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#75D6AE" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#8C75D6AE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#F0F4FC" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="14"
                                  Height="14"
                                  Margin="0,2,0,0"
                                  VerticalAlignment="Top">
                                <Ellipse x:Name="Ring"
                                         Stroke="#55FFFFFF"
                                         StrokeThickness="1"
                                         Fill="#1FFFFFFF" />
                                <Ellipse x:Name="Dot"
                                         Width="6"
                                         Height="6"
                                         Fill="#75D6AE"
                                         Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Top" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="#75D6AE" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="#8C75D6AE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="NavSurface"
                                CornerRadius="8"
                                Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavSurface" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavSurface" Property="Background" Value="#2A75D6AE" />
                                <Setter Property="Foreground" Value="#F4FFF9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 系统滚动条是浅色的，在深色卡片上非常刺眼，改成 8px 的暗色细条 -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbSurface"
                                                        CornerRadius="3"
                                                        Margin="1,0"
                                                        Background="#33FFFFFF" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbSurface" Property="Background" Value="#5CFFFFFF" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbSurface" Property="Background" Value="#8C75D6AE" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="NaN" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="8" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="VerticalAlignment" Value="Bottom" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid"
          Background="Transparent">

        <!-- 投影层 -->
        <Border Margin="34"
                CornerRadius="24"
                Effect="{DynamicResource CardShadow}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#D91B2438" Offset="0" />
                    <GradientStop Color="#D9121928" Offset="0.55" />
                    <GradientStop Color="#D90C111D" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- 卡片本体 -->
        <Border x:Name="Card"
                Margin="34"
                CornerRadius="24"
                BorderBrush="#28FFFFFF"
                BorderThickness="1">

            <Grid x:Name="CardClip"
                  ClipToBounds="True"
                  SizeChanged="CardClip_SizeChanged">

                <!-- 左上青色光晕 -->
                <Ellipse Width="430" Height="330"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         Margin="-130,-160,0,0"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#3A4ED6C6" Offset="0" />
                            <GradientStop Color="#164ED6C6" Offset="0.45" />
                            <GradientStop Color="#004ED6C6" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- 右下紫色光晕 -->
                <Ellipse Width="470" Height="350"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Margin="0,0,-160,-160"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#366C62D8" Offset="0" />
                            <GradientStop Color="#146C62D8" Offset="0.48" />
                            <GradientStop Color="#006C62D8" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- 中央压暗，保证文字对比 -->
                <Border IsHitTestVisible="False">
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0.46"
                                             GradientOrigin="0.5,0.46"
                                             RadiusX="0.78"
                                             RadiusY="0.9">
                            <GradientStop Color="#1C000000" Offset="0" />
                            <GradientStop Color="#12000000" Offset="0.6" />
                            <GradientStop Color="#08000000" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 噪点 -->
                <Rectangle x:Name="NoiseLayer"
                           Opacity="0.55"
                           IsHitTestVisible="False" />

                <!-- 顶部高光 -->
                <Border Height="1"
                        VerticalAlignment="Top"
                        Margin="24,0"
                        IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FFFFFF" Offset="0" />
                            <GradientStop Color="#66FFFFFF" Offset="0.2" />
                            <GradientStop Color="#66FFFFFF" Offset="0.8" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 内描边 -->
                <Border CornerRadius="23"
                        BorderBrush="#12FFFFFF"
                        BorderThickness="1"
                        IsHitTestVisible="False" />

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 标题栏 -->
                    <Grid Grid.Row="0"
                          Margin="18,0,12,0"
                          Background="Transparent"
                          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Ellipse Width="5"
                                     Height="5"
                                     Margin="1,0,8,0"
                                     Fill="#75D6AE" />
                            <TextBlock Text="设置"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#E9EFFB"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource CloseButtonStyle}"
                                Content="&#xE711;"
                                ToolTip="关闭设置"
                                Click="CloseButton_Click" />
                    </Grid>

                <Grid Grid.Row="1" Margin="18,0,18,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="148" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧导航 -->
                    <ListBox Grid.Column="0"
                             Margin="0,2,20,0"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding Sections}"
                             SelectedItem="{Binding SelectedSection, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource NavItemStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="13" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 右侧内容 -->
                    <Grid Grid.Column="1">
                        <Grid Visibility="{Binding IsReadingSelected, Converter={StaticResource BoolToVisibility}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="阅读" Style="{StaticResource HeadingStyle}" />
                                    <TextBlock Text="按秒轮换，评级只改变之后的出现权重。"
                                               Margin="0,7,0,22"
                                               Style="{StaticResource MutedTextStyle}" />

                                    <StackPanel>
                                        <RadioButton GroupName="ReadingMode"
                                                     Margin="0,0,0,10"
                                                     Foreground="#F0F4FC"
                                                     Style="{StaticResource SettingsRadioButtonStyle}"
                                                     IsChecked="{Binding Reading.IsFlashMode, Mode=TwoWay}">
                                            <StackPanel Margin="5,0,0,0">
                                                <TextBlock Text="Flash 定时闪卡" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="按秒轮换，评级只记录，不打断节奏"
                                                           Margin="0,3,0,0"
                                                           Style="{StaticResource MutedTextStyle}" />
                                            </StackPanel>
                                        </RadioButton>

                                        <RadioButton GroupName="ReadingMode"
                                                     Foreground="#F0F4FC"
                                                     Style="{StaticResource SettingsRadioButtonStyle}"
                                                     IsChecked="{Binding Reading.IsClickMode, Mode=TwoWay}">
                                            <StackPanel Margin="5,0,0,0">
                                                <TextBlock Text="点击优先" FontSize="13" FontWeight="SemiBold" />
                                                <TextBlock Text="点击评级立即换词，不操作时也会自动轮换"
                                                           Margin="0,3,0,0"
                                                           Style="{StaticResource MutedTextStyle}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>

                                    <Border Style="{StaticResource CardStyle}" Margin="0,20,0,0">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="轮换间隔" Style="{StaticResource SectionTitleStyle}" />
                                                <TextBlock Text="{Binding Reading.IntervalText}"
                                                           HorizontalAlignment="Right"
                                                           FontSize="11.5"
                                                           Foreground="{StaticResource AccentBrush}" />
                                            </Grid>
                                            <Slider Margin="0,14,0,0"
                                                    Minimum="1"
                                                    Maximum="60"
                                                    TickFrequency="1"
                                                    IsSnapToTickEnabled="True"
                                                    IsMoveToPointEnabled="True"
                                                    Value="{Binding Reading.IntervalSeconds, Mode=TwoWay}" />
                                            <CheckBox Content="鼠标悬停在窗口上时暂停计时"
                                                      Style="{StaticResource SettingsCheckBoxStyle}"
                                                      Margin="0,16,0,0"
                                                      Foreground="#DCE4F2"
                                                      IsChecked="{Binding Reading.PauseOnHover, Mode=TwoWay}"
                                                      IsEnabled="{Binding Reading.IsFlashMode}" />
                                            <CheckBox Content="显示例句"
                                                      Style="{StaticResource SettingsCheckBoxStyle}"
                                                      Margin="0,10,0,0"
                                                      Foreground="#DCE4F2"
                                                      IsChecked="{Binding Reading.ShowExamples, Mode=TwoWay}" />
                                            <TextBlock Text="只显示第一个义项的一条例句；关闭后卡片更紧凑。"
                                                       Margin="0,5,0,0"
                                                       Style="{StaticResource MutedTextStyle}" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="{Binding Reading.Summary}"
                                               Margin="0,15,0,0"
                                               Style="{StaticResource MutedTextStyle}" />
                                    <TextBlock Text="{Binding Reading.ErrorMessage}"
                                               Margin="0,8,0,0"
                                               Foreground="#F3A3AE"
                                               FontSize="11.5"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding Reading.HasError, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <Grid Visibility="{Binding IsListsSelected, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="词书" Style="{StaticResource HeadingStyle}" />
                                <DockPanel Margin="0,7,0,16">
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Content="刷新"
                                                Command="{Binding Lists.RefreshCommand}"
                                                Style="{StaticResource SettingsButtonStyle}"
                                                Margin="0,0,8,0" />
                                        <Button Content="打开数据目录"
                                                Command="{Binding Lists.OpenFolderCommand}"
                                                Style="{StaticResource SettingsButtonStyle}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding Lists.CountText}"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource MutedTextStyle}" />
                                </DockPanel>
                                <TextBlock Text="{Binding Lists.StatusMessage}"
                                           Foreground="#A9DCC6"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Lists.HasStatus, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Lists.Lists}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,9">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="14"
                                                                           FontWeight="SemiBold" />
                                                                <Border Margin="8,0,0,0"
                                                                        Padding="6,1"
                                                                        CornerRadius="5"
                                                                        Background="#2A75D6AE"
                                                                        Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibility}}">
                                                                    <TextBlock Text="当前"
                                                                               FontSize="10"
                                                                               Foreground="#D9FFF0" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding CountsText}"
                                                                       Margin="0,5,0,0"
                                                                       Style="{StaticResource MutedTextStyle}" />
                                                            <TextBlock Text="{Binding ListIdText}"
                                                                       Margin="0,2,0,0"
                                                                       Style="{StaticResource MutedTextStyle}" />
                                                            <TextBlock Text="{Binding SourceText}"
                                                                       Margin="0,2,0,0"
                                                                       Style="{StaticResource MutedTextStyle}" />
                                                            <TextBlock Text="{Binding ImportedLine}"
                                                                       Margin="0,2,0,0"
                                                                       Style="{StaticResource MutedTextStyle}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1"
                                                                    Orientation="Horizontal"
                                                                    VerticalAlignment="Center"
                                                                    Margin="12,0,0,0">
                                                            <Button Content="使用"
                                                                    Command="{Binding DataContext.Lists.SelectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource SmallButtonStyle}"
                                                                    Margin="0,0,6,0" />
                                                            <Button Content="重命名"
                                                                    Command="{Binding DataContext.Lists.RenameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource SmallButtonStyle}"
                                                                    Margin="0,0,6,0" />
                                                            <Button Content="删除"
                                                                    Command="{Binding DataContext.Lists.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource SmallButtonStyle}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock Text="还没有词书。请到“导入”中添加。"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource MutedTextStyle}"
                                           Visibility="{Binding Lists.HasNoLists, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Grid>

                        <Grid Visibility="{Binding IsImportSelected, Converter={StaticResource BoolToVisibility}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="导入" Style="{StaticResource HeadingStyle}" />
                                    <TextBlock Text="选择 JSON 词书，校验通过后写入数据库。源文件不会被复制。"
                                               Margin="0,7,0,18"
                                               Style="{StaticResource MutedTextStyle}" />

                                    <WrapPanel>
                                        <Button Content="选择 JSON 文件"
                                                Command="{Binding Import.ChooseFileCommand}"
                                                Style="{StaticResource SettingsButtonStyle}"
                                                Margin="0,0,10,0" />
                                        <Button Content="{Binding Import.ImportButtonText}"
                                                Command="{Binding Import.ImportCommand}"
                                                IsEnabled="{Binding Import.CanImport}"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                    </WrapPanel>

                                    <TextBlock Text="Excel 导入接口已预留，当前版本暂不提供。"
                                               Margin="0,10,0,0"
                                               Style="{StaticResource MutedTextStyle}" />

                                    <Border Style="{StaticResource CardStyle}"
                                            Margin="0,18,0,0"
                                            Visibility="{Binding Import.HasPreview, Converter={StaticResource BoolToVisibility}}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="{Binding Import.FileName}"
                                                           Style="{StaticResource SectionTitleStyle}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Import.FileSizeText}"
                                                           HorizontalAlignment="Right"
                                                           Style="{StaticResource MutedTextStyle}" />
                                            </Grid>
                                            <TextBlock Text="{Binding Import.SourcePath}"
                                                       Margin="0,5,0,0"
                                                       Style="{StaticResource MutedTextStyle}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Border Height="1"
                                                    Background="{StaticResource LineBrush}"
                                                    Margin="0,11,0,10" />
                                            <TextBlock Text="{Binding Import.ListName}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Import.ListIdText}"
                                                       Margin="0,4,0,0"
                                                       Style="{StaticResource MutedTextStyle}" />
                                            <TextBlock Text="{Binding Import.CountsText}"
                                                       Margin="0,3,0,0"
                                                       Style="{StaticResource MutedTextStyle}" />
                                        </StackPanel>
                                    </Border>

                                    <ItemsControl ItemsSource="{Binding Import.Issues}"
                                                  Margin="0,12,0,0"
                                                  Visibility="{Binding Import.HasIssues, Converter={StaticResource BoolToVisibility}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}"
                                                           Margin="0,0,0,4"
                                                           Foreground="#F3A3AE"
                                                           FontSize="11.5"
                                                           TextWrapping="Wrap" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding Import.StatusMessage}"
                                               Margin="0,12,0,0"
                                               Foreground="#A9DCC6"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding Import.HasStatus, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <Grid Visibility="{Binding IsStylesSelected, Converter={StaticResource BoolToVisibility}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="样式" Style="{StaticResource HeadingStyle}" />
                                <Grid Margin="0,7,0,14">
                                    <Button Content="恢复默认样式"
                                            Command="{Binding Styles.ResetCommand}"
                                            Style="{StaticResource SettingsButtonStyle}"
                                            HorizontalAlignment="Right" />
                                    <TextBlock Text="按 role 编辑字体、字号、字重和颜色。"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource MutedTextStyle}" />
                                </Grid>
                                <TextBlock Text="{Binding Styles.StatusMessage}"
                                           Foreground="#A9DCC6"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding Styles.HasStatus, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Styles.Roles}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,9">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   Style="{StaticResource SectionTitleStyle}" />
                                                        <TextBlock Text="{Binding Role}"
                                                                   HorizontalAlignment="Right"
                                                                   Style="{StaticResource MutedTextStyle}" />
                                                    </Grid>

                                                    <Border Margin="0,9,0,10"
                                                            Padding="10,8"
                                                            CornerRadius="7"
                                                            Background="{Binding PreviewBackground}"
                                                            BorderBrush="#22FFFFFF"
                                                            BorderThickness="1">
                                                        <TextBlock Text="{Binding SampleText}"
                                                                   FontFamily="{Binding PreviewFontFamily}"
                                                                   FontSize="{Binding PreviewFontSize}"
                                                                   FontWeight="{Binding PreviewFontWeight}"
                                                                   FontStyle="{Binding PreviewFontStyle}"
                                                                   Foreground="{Binding PreviewForeground}"
                                                                   TextWrapping="Wrap" />
                                                    </Border>

                                                    <WrapPanel>
                                                        <StackPanel Margin="0,0,10,8">
                                                            <TextBlock Text="字体族" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4" />
                                                            <ComboBox Width="170"
                                                                      ItemsSource="{Binding FontFamilies}"
                                                                      IsEditable="True"
                                                                      Text="{Binding FontFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      Style="{StaticResource SettingsComboBoxStyle}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,10,8">
                                                            <TextBlock Text="字号" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4" />
                                                            <TextBox Width="62"
                                                                     Text="{Binding FontSizeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource SettingsTextBoxStyle}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,10,8">
                                                            <TextBlock Text="字重" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4" />
                                                            <ComboBox Width="112"
                                                                      ItemsSource="{Binding FontWeights}"
                                                                      SelectedItem="{Binding FontWeight, Mode=TwoWay}"
                                                                      Style="{StaticResource SettingsComboBoxStyle}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,10,8">
                                                            <TextBlock Text="文字颜色" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4" />
                                                            <TextBox Width="96"
                                                                     Text="{Binding Color, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource SettingsTextBoxStyle}" />
                                                        </StackPanel>
                                                        <StackPanel Margin="0,0,10,8"
                                                                    Visibility="{Binding IsLabel, Converter={StaticResource BoolToVisibility}}">
                                                            <TextBlock Text="标签背景" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,4" />
                                                            <TextBox Width="96"
                                                                     Text="{Binding BackgroundColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource SettingsTextBoxStyle}" />
                                                        </StackPanel>
                                                        <CheckBox Content="斜体"
                                                                  Style="{StaticResource SettingsCheckBoxStyle}"
                                                                  VerticalAlignment="Bottom"
                                                                  Margin="0,0,0,12"
                                                                  Foreground="#DCE4F2"
                                                                  IsChecked="{Binding Italic, Mode=TwoWay}" />
                                                    </WrapPanel>

                                                    <TextBlock Text="{Binding Error}"
                                                               Foreground="#F3A3AE"
                                                               FontSize="11.5"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </Grid>
                </Grid>
            </Grid>
        </Border>

        <Thumb Width="18"
               Height="18"
               Margin="40"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Opacity="0"
               Cursor="SizeNWSE"
               DragDelta="ResizeThumb_DragDelta" />
    </Grid>
</Window>
