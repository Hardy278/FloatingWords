<Window x:Class="FloatingWords.Dialogs.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="424"
        Height="252"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Grayscale"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        Foreground="#F0F3FA">

    <Window.Resources>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AEB8CC" />
        <SolidColorBrush x:Key="HoverWashBrush" Color="#14FFFFFF" />

        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="28"
                          ShadowDepth="7"
                          Direction="270"
                          Opacity="0.42"
                          Color="#000000" />

        <Style x:Key="TextButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                Background="Transparent"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background"
                                        Value="{StaticResource HoverWashBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource TextButtonStyle}">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFD8DE" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PromptPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="Foreground" Value="#F4FFF9" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PrimarySurface"
                                CornerRadius="10"
                                BorderThickness="1"
                                BorderBrush="#5575D6AE"
                                Padding="{TemplateBinding Padding}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#3875D6AE" Offset="0" />
                                    <GradientStop Color="#2E79AEF2" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimarySurface" Property="BorderBrush" Value="#A075D6AE" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PrimarySurface" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PromptTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#F5F8FF" />
            <Setter Property="CaretBrush" Value="#F5F8FF" />
            <Setter Property="SelectionBrush" Value="#6075D6AE" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputSurface"
                                CornerRadius="8"
                                Background="#1FFFFFFF"
                                BorderBrush="#2EFFFFFF"
                                BorderThickness="1">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="InputSurface" Property="Background" Value="#2BFFFFFF" />
                                <Setter TargetName="InputSurface" Property="BorderBrush" Value="#8C75D6AE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid"
          Background="Transparent"
          MouseLeftButtonDown="RootGrid_MouseLeftButtonDown">

        <!-- 投影层 -->
        <Border Margin="34"
                CornerRadius="24"
                Effect="{DynamicResource CardShadow}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#D91B2438" Offset="0" />
                    <GradientStop Color="#D9121928" Offset="0.55" />
                    <GradientStop Color="#D90C111D" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- 卡片本体 -->
        <Border x:Name="Card"
                Margin="34"
                CornerRadius="24"
                BorderBrush="#28FFFFFF"
                BorderThickness="1">

            <Grid x:Name="CardClip"
                  ClipToBounds="True"
                  SizeChanged="CardClip_SizeChanged">

                <!-- 左上青色光晕 -->
                <Ellipse Width="290" Height="230"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         Margin="-90,-120,0,0"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#3A4ED6C6" Offset="0" />
                            <GradientStop Color="#164ED6C6" Offset="0.45" />
                            <GradientStop Color="#004ED6C6" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- 右下紫色光晕 -->
                <Ellipse Width="300" Height="230"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Margin="0,0,-110,-110"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#366C62D8" Offset="0" />
                            <GradientStop Color="#146C62D8" Offset="0.48" />
                            <GradientStop Color="#006C62D8" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <!-- 中央压暗，保证文字对比 -->
                <Border IsHitTestVisible="False">
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0.46"
                                             GradientOrigin="0.5,0.46"
                                             RadiusX="0.78"
                                             RadiusY="0.9">
                            <GradientStop Color="#1C000000" Offset="0" />
                            <GradientStop Color="#12000000" Offset="0.6" />
                            <GradientStop Color="#08000000" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 噪点 -->
                <Rectangle x:Name="NoiseLayer"
                           Opacity="0.55"
                           IsHitTestVisible="False" />

                <!-- 顶部高光 -->
                <Border Height="1"
                        VerticalAlignment="Top"
                        Margin="24,0"
                        IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#00FFFFFF" Offset="0" />
                            <GradientStop Color="#66FFFFFF" Offset="0.2" />
                            <GradientStop Color="#66FFFFFF" Offset="0.8" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>

                <!-- 内描边 -->
                <Border CornerRadius="23"
                        BorderBrush="#12FFFFFF"
                        BorderThickness="1"
                        IsHitTestVisible="False" />

                <Grid Margin="20,15,20,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 顶栏 -->
                    <Grid Grid.Row="0" Height="24">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Ellipse Width="5"
                                     Height="5"
                                     Margin="1,0,8,0"
                                     Fill="#75D6AE" />
                            <TextBlock x:Name="TitleText"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#E9EFFB"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource CloseButtonStyle}"
                                Content="&#xE711;"
                                ToolTip="关闭"
                                IsCancel="True" />
                    </Grid>

                    <Grid Grid.Row="1"
                          Margin="0,17,0,7">
                        <TextBlock x:Name="LabelText"
                                   VerticalAlignment="Top"
                                   FontSize="11.5"
                                   Foreground="#9DABC3" />
                        <TextBlock x:Name="ErrorText"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Top"
                                   FontSize="11.5"
                                   Foreground="#F3A3AE"
                                   Text="名称不能为空"
                                   Visibility="Collapsed" />
                    </Grid>

                    <TextBox x:Name="ValueBox"
                             Grid.Row="2"
                             Style="{StaticResource PromptTextBoxStyle}"
                             TextChanged="ValueBox_TextChanged" />

                    <StackPanel Grid.Row="4"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,14,0,0">
                        <TextBlock Text="Enter 确定 · Esc 取消"
                                   Margin="0,0,14,0"
                                   VerticalAlignment="Center"
                                   FontSize="10.5"
                                   Foreground="#6F7E96" />
                        <Button Content="取消"
                                Margin="0,0,10,0"
                                IsCancel="True"
                                Style="{StaticResource TextButtonStyle}" />
                        <Button Content="确定"
                                IsDefault="True"
                                Click="OkButton_Click"
                                Style="{StaticResource PromptPrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
